{
  "name": "netcraft",
  "productName": "RackDraw",
  "version": "1.11.0",
  "description": "RackDraw: free network, rack and floor-plan diagrams for client documentation",
  "author": "crlsgeraldino",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./tests/register.mjs --test \"tests/*.test.ts\"",
    "e2e": "playwright test",
    "notices": "node scripts/third-party-notices.mjs",
    "postbuild": "node -e \"for (const f of ['THIRD-PARTY-NOTICES.md', 'LICENSE']) require('fs').copyFileSync(f, 'out/' + f)\"",
    "icons": "node scripts/make-icons.mjs",
    "serve": "npx --yes serve@14 out -l 3124",
    "desktop": "next build && electron .",
    "dist:win": "next build && electron-builder --win"
  },
  "build": {
    "appId": "com.crlsgeraldino.netcraft",
    "productName": "RackDraw",
    "copyright": "MIT License",
    "electronLanguages": [
      "en-US"
    ],
    "fileAssociations": [
      {
        "ext": "rackdraw",
        "name": "RackDraw drawing",
        "description": "RackDraw client drawing",
        "mimeType": "application/vnd.rackdraw+zip",
        "role": "Editor"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "out/**",
      "build/icon.png",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.RackDraw.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RackDraw",
      "artifactName": "RackDraw-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xyflow/react": "^13.0.2",
    "electron": "45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "next": "15.5.29",
    "pdfjs-dist": "6.5.438",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zustand": "^5.1.0"
  }
}
